# ==========================================
# Event Manager Front - .gitignore
# ==========================================

# Dependencias (Dependencies)
node_modules/
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Compilación y Salidas de Build (Build outputs)
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
storybook-static/

# Variables de entorno y credenciales (Env & Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Registros (Logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Pruebas y Cobertura (Testing & Coverage)
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# Cachés y Archivos Temporales (Cache & Temporary)
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo
tmp/
temp/

# Editores e IDEs (Editor directories)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Archivos del Sistema Operativo (OS generated files)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Agentes de IA y configuración local de asistentes (AI Agents)
.gemini/
.agents/

# Notas personales y archivos locales (Local notes & diaries)
event-manager-diario.md
*diario*.md
*.local.md
